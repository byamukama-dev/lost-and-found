# Copy this file to .env. Never commit .env or share your SMTP password.
APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:5000
PORT=5000
# Blank SECRET_KEY creates a random key in your persistent data folder.
# For production set a private, random string with at least 32 characters.
SECRET_KEY=
# Optional absolute data directory. Keep it on a persistent local disk.
# CAMPUSFIND_DATA_DIR=C:/campusfind-data

# Obtain these values from your email delivery provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_SENDER=

# Set to 1 ONLY behind exactly one trusted reverse proxy which overwrites
# forwarded headers and is the only route to the application server.
TRUST_PROXY=0
